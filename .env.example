# Leave both empty to run in "this device only" mode (progress saved in the browser).
# Fill them in (Supabase → Project Settings → API) to sync across devices.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for accounts made before sign-up used real emails: their username
# was stored as {username}@{this domain}. New accounts don't use it.
NEXT_PUBLIC_USERNAME_EMAIL_DOMAIN=myoptomcompanion.local
